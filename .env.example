# Required: your OpenRouter API key - https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-key

# Optional overrides
SEPICODE_MODEL=anthropic/claude-opus-4.8
SEPICODE_SUBAGENT_MODEL=anthropic/claude-opus-4.8
SEPICODE_MAX_STEPS=20
SEPICODE_MAX_COST=1.0
SEPICODE_REASONING_EFFORT=medium
SEPICODE_TEMPERATURE=0
SEPICODE_THEME=catppuccin-mocha
# SEPICODE_SESSION_DIR=
# SEPICODE_STATE_FILE=
