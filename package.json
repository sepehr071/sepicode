{
  "name": "sepicode",
  "version": "0.1.0",
  "type": "module",
  "description": "Strong terminal coding agent with a modern TUI — @openrouter/agent + @opentui/react on Bun.",
  "bin": {
    "sepicode": "bin/sepicode.ts"
  },
  "scripts": {
    "start": "bun src/cli.tsx",
    "dev": "bun --watch src/cli.tsx",
    "demo": "bun scripts/demo.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openrouter/agent": "^0.7.2",
    "@opentui/core": "0.4.1",
    "@opentui/react": "0.4.1",
    "glob": "^11.0.0",
    "react": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "typescript": "^5.6.0"
  }
}
